# Base URL da API Rust, sem acrescentar o caminho /api/catalog.
# O Axum local e a Function Rust da Vercel oferecem o mesmo contrato.
# Exemplo local: http://127.0.0.1:8080
# Em produção, deixe vazio para usar a API same-origin da Vercel.
NEXT_PUBLIC_DARK_LEGION_API_URL=http://127.0.0.1:8080

# Opcional para executar o backend local com PostgreSQL.
# O backend Rust lê DATABASE_URL do ambiente do processo.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/dark_legion

# Defina a origem real da Vercel antes de publicar sitemap e canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
